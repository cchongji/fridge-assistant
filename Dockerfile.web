# 多阶段构建：容器内构建 Vite + Vue3 + Element Plus 前端，再用 Caddy 提供静态服务
FROM node:22-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
# 只做 vite build（类型检查在 CI/本地完成，避免构建期因类型报错阻塞部署）
RUN npm run build:only

FROM caddy:2-alpine
COPY --from=build /app/dist /srv/h5
COPY Caddyfile /etc/caddy/Caddyfile
